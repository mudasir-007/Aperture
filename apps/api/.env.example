# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env file.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# SQLite file path (MVP default; see docs/architecture.md for the
# Postgres+pgvector production migration path).
DB_FILE=./data/dev.db

# --- Auth ---
# Generate a strong random value for real deployments, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1d

# --- AI Providers ---
# Leave these unset to use the built-in deterministic Mock providers, which
# make the whole application (ingestion + chat) runnable end-to-end with no
# external API keys and no network access -- this is what CI/tests use.
# Set EMBEDDING_PROVIDER=openai / LLM_PROVIDER=openai and provide an API key
# to use real OpenAI-compatible embeddings and generation.
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Retrieval tuning ---
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120
RETRIEVAL_TOP_K=5

# --- CORS ---
WEB_ORIGIN=http://localhost:5173
