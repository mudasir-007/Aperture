{
  "name": "@rag-chat-app/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.eslint.json --noEmit",
    "test": "NODE_ENV=test DB_FILE=\"./data/test.db\" JWT_SECRET=\"test-secret-please-ignore-1234\" EMBEDDING_PROVIDER=mock LLM_PROVIDER=mock jest --runInBand",
    "seed": "ts-node --transpile-only scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.4.0",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "zod": "3.23.8",
    "bullmq": "^5.34.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "1.4.12",
    "@types/node": "20.14.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.3"
  }
}
