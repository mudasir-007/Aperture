{
  "name": "aperture",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "smoke": "bash scripts/smoke.sh",
    "eval": "npm run eval --workspace apps/api",
    "eval:retrieval-only": "npm run eval:retrieval-only --workspace apps/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}